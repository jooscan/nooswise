# Copy to .env on the VM (NOT committed) and fill in.
#   cp .env.production.example .env && nano .env

# The domain you registered, pointed at this VM's external IP with an A record.
# Caddy requests the TLS certificate for exactly this name, so it must resolve here
# before you start the stack.
NOOSWISE_DOMAIN=nooswise.example.com

# Let's Encrypt uses this only to warn you about expiry problems.
NOOSWISE_ACME_EMAIL=you@example.com

# Postgres credentials. Generate the password once and never reuse it:
#   openssl rand -base64 32
POSTGRES_USER=nooswise
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nooswise

# GCS bucket for nightly backups, without the gs:// prefix.
BACKUP_BUCKET=nooswise-backups

# Optional image tag, set by deploy/update.sh to the deployed commit.
NOOSWISE_TAG=latest
