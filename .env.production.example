# Copy to .env on the VM (NOT committed) and fill in.
#   cp .env.production.example .env && nano .env

# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> your tunnel ->
# Overview. The install command shown there embeds this token; copy just the token
# value (a long string starting with "ey...").
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Postgres credentials. Generate the password once and never reuse it:
#   openssl rand -base64 32
POSTGRES_USER=nooswise
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nooswise

# GCS bucket for nightly backups, without the gs:// prefix.
BACKUP_BUCKET=nooswise-backups-CHANGE_ME

# Optional image tag, set by deploy/update.sh to the deployed commit.
NOOSWISE_TAG=latest
