# Caddy fetches and renews the TLS certificate for this domain automatically.
# NOOSWISE_DOMAIN and NOOSWISE_ACME_EMAIL come from .env via docker compose.
{
	email {$NOOSWISE_ACME_EMAIL}
	# Trim the admin API; nothing here uses it.
	admin off
}

{$NOOSWISE_DOMAIN} {
	encode zstd gzip

	# The share link is the only thing protecting a split, so keep it out of the
	# Referer header sent to any third-party asset host.
	header {
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# flush_interval -1 disables response buffering. Without it Caddy holds the
	# server-sent events stream in its buffer and live updates never arrive.
	reverse_proxy app:3000 {
		flush_interval -1
	}
}
